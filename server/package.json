{
    "name": "hireflow-server",
    "version": "1.0.0",
    "description": "HireFlow API - Express 5 + TypeScript + Supabase",
    "private": true,
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "typecheck": "tsc --noEmit",
        "test": "tsc -p tsconfig.test.json && node --test .test-dist/tests/*.test.js"
    },
    "engines": {
        "node": ">=20"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.45.4",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^5.1.0",
        "express-rate-limit": "^8.0.1",
        "helmet": "^8.1.0",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/cookie-parser": "^1.4.8",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/node": "^22.7.0",
        "tsx": "^4.19.2",
        "typescript": "^5.6.3"
    }
}
