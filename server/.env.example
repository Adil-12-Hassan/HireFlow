# HireFlow server - copy this file to .env and fill in your own values
# Never commit .env to GitHub. Only .env.example is committed.

# Server
PORT=5000
NODE_ENV=development

# Frontend URL, used for CORS, the CSRF origin check and email links.
# Local Vite default is http://localhost:5173
# You can list several origins separated by commas, the first one is used in emails:
# FRONTEND_URL=https://hireflow.example.com,http://localhost:5173
# No path, and a trailing slash is ignored.
FRONTEND_URL=http://localhost:5173

# Supabase - get these from Supabase Dashboard > Project Settings > API
# SUPABASE_URL looks like https://your-project-ref.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Server only. Never put this in the frontend, never share it, never commit it.
# This key bypasses RLS, so Express must check ownership on every protected route.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here